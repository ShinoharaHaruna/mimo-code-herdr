#!/bin/sh
# mimo-code-herdr shim (optional mode).
#
# Inside a Herdr pane, the `opencode` command launches MiMo Code under the
# opencode process identity (argv[0] = "opencode"), so `herdr agent start
# --kind opencode` can register it with the FULL agent surface: `agent
# prompt`, `agent wait`, `agent read`, native session identity, and automatic
# row cleanup on exit.
#
# Outside Herdr the shim is a transparent pass-through to the real opencode.
# This makes it safe to keep the shim dir at the front of PATH.
#
# Installed by `mimo-herdr install --shim`.

if [ "${HERDR_ENV:-}" = "1" ] && [ -n "${HERDR_PANE_ID:-}" ]; then
  exec -a opencode "__MIMO_BIN__" "$@"
fi
exec "__OPENCODE_BIN__" "$@"
